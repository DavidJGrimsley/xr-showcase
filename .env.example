# Copy to .env locally, or configure the same values in the EAS development environment.
# This hackathon demo intentionally bundles EXPO_PUBLIC_* values in the client.
# Supply the existing demo key once at build time; players never enter a key.
EXPO_PUBLIC_QUANTUM_API_BASE_URL=https://davidjgrimsley.com/public-facing/api/quantum/v1
EXPO_PUBLIC_QUANTUM_API_KEY=
EXPO_PUBLIC_QUANTUM_BACKEND=ibm_kingston
EXPO_PUBLIC_QUANTUM_IBM_PROFILE="Unreal Engine Demos"

# ReactVision app SDK key; client-visible in the native binary and Expo configuration.
# Keep its value only in ignored .env / the EAS development environment, never Git.
RV_API_KEY=
RV_PROJECT_ID=f3eab820-8174-4b7b-a79e-854dab36e16a
