{
  "name": "xr-showcase",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo start --android",
    "ios": "expo start --ios",
    "start": "expo start --dev-client",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "typecheck": "tsc --noEmit",
    "mds:continue": "npx mds continue",
    "mds:doctor": "npx mds doctor",
    "mds:doctor:ci": "npx mds doctor --ci",
    "mds:react-doctor": "npx mds run react-doctor",
    "mds:eject": "npx mds eject .",
    "mds:eject:exposition": "npx mds eject exposition .",
    "mds:eject:stylist": "npx mds eject stylist .",
    "free-port": "npx mds free-port",
    "clear-expo-start": "npx mds clear-expo-start",
    "expo-install-fix": "npx expo install --fix",
    "expo-doctor": "npx expo-doctor",
    "post-create-check": "npx expo install --fix && npx expo-doctor",
    "ci:verify": "npx mds doctor --ci",
    "test": "npm run lint && npm run typecheck && npm run test:ar && npm run test:qubit",
    "test:ar": "node --experimental-strip-types --test tests/ar-session.test.cjs",
    "test:qubit": "node --experimental-strip-types --test tests/qubit-*.test.cjs",
    "build:ios": "expo export --platform ios --max-workers 2",
    "react:check": "react-doctor -y --no-telemetry",
    "build": "npm run build:ios"
  },
  "dependencies": {
    "@expo/log-box": "^57.0.4",
    "@expo/ui": "~57.0.22",
    "@expo/vector-icons": "^15.0.2",
    "@mr.dj2u/quantum-api": "0.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@reactvision/react-viro": "^3.0.3",
    "expo": "^57.0.27",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-navigation-bar": "~57.0.3",
    "expo-router": "^57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "uniwind": "^1.12.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@mr.dj2u/cli": "^0.3.0",
    "@types/node": "^25.9.1",
    "@types/react": "~19.2.2",
    "eslint": "^9.25.1",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.2",
    "prettier": "^3.2.5",
    "react-doctor": "^0.9.12",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.3"
  },
  "private": true
}
